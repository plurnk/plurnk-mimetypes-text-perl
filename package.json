{
    "name": "@plurnk/plurnk-mimetypes-text-perl",
    "version": "0.1.2",
    "description": "text/x-perl mimetype handler for plurnk-service. Tier 2: tree-sitter-perl grammar built to WASM and shipped pre-built. Covers packages, subroutines (with signatures), and variable declarations.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=25"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/x-perl",
                "glyph": "🐪",
                "extensions": [
                    ".pl",
                    ".pm",
                    ".t",
                    ".pod"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./perl.wasm": "./perl.wasm"
    },
    "files": [
        "dist/**/*",
        "perl.wasm",
        ".perl-grammar-pin",
        "README.md"
    ],
    "scripts": {
        "build:wasm": "node scripts/build-wasm.mjs",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "prepare": "npm run build",
        "verify:wasm": "node scripts/verify-wasm.mjs"
    },
    "dependencies": {
        "web-tree-sitter": "^0.25.10"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "tree-sitter-cli": "^0.26.9",
        "typescript": "^6.0.3",
        "@plurnk/plurnk-mimetypes": "^0.15.0"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^0.15.0"
    }
}
